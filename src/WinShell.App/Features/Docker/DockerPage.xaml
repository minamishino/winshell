<Page x:Class="WinShell.App.Features.Docker.DockerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:docker="using:WinShell.Core.Docker"
      Loaded="Page_Loaded">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Docker" Style="{ThemeResource SubtitleTextBlockStyle}" ToolTipService.ToolTip="显示最近 32 个容器"/>
        <Expander Grid.Row="1" Header="服务器要求" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <TextBlock Text="仅支持 Linux / POSIX。服务器需已安装 Docker CLI，SSH 账号需有 /var/run/docker.sock 权限。" TextWrapping="Wrap"/>
        </Expander>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfilesSelector" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                      HorizontalAlignment="Stretch" PlaceholderText="选择 SSH 配置" AutomationProperties.Name="Docker 服务器 SSH 配置"/>
            <Button Grid.Column="1" Content="更新配置" Click="Reload_Click" IsEnabled="{Binding CanAct}" AutomationProperties.Name="重新载入保存的 SSH 配置"/>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="验证 / 刷新" Click="Refresh_Click" IsEnabled="{Binding CanAct}" AutomationProperties.Name="验证服务器 Docker 并刷新最近 32 个容器"/>
        </Grid>
        <ListView x:Name="ContainerList" Grid.Row="3" ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                  SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="最近 32 个 Docker 容器">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="docker:DockerContainerSummary">
                    <StackPanel Spacing="3" Padding="4">
                        <TextBlock Text="{Binding Names}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Image}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Ports}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <CommandBar Grid.Row="4" DefaultLabelPosition="Right" AutomationProperties.Name="容器操作">
            <AppBarButton Icon="Play" Label="启动" Click="Start_Click" IsEnabled="{Binding CanAct}" AutomationProperties.Name="启动选中容器"/>
            <AppBarButton Icon="Stop" Label="停止" Click="Stop_Click" IsEnabled="{Binding CanAct}" AutomationProperties.Name="确认停止选中容器"/>
            <AppBarButton Icon="Refresh" Label="重启" Click="Restart_Click" IsEnabled="{Binding CanAct}" AutomationProperties.Name="确认重启选中容器"/>
            <AppBarButton Icon="Document" Label="日志" Click="Logs_Click" IsEnabled="{Binding CanAct}" AutomationProperties.Name="读取选中容器最近 200 行日志"/>
            <AppBarButton Icon="Cancel" Label="取消" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" AutomationProperties.Name="取消当前 Docker 操作并等待关闭"/>
        </CommandBar>
        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="一次性容器命令（/bin/sh -c，最多 4096 UTF-8 字节）"
                     MaxLength="4096" AutomationProperties.Name="一次性容器命令"/>
            <Button Grid.Column="1" Content="执行" Click="Command_Click" IsEnabled="{Binding CanAct}" VerticalAlignment="Bottom" AutomationProperties.Name="确认执行一次性容器命令"/>
        </Grid>
        <TextBox Grid.Row="6" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 Header="本次结果（标准输出最多 32 KiB，错误输出最多 16 KiB）" FontFamily="Consolas" AutomationProperties.Name="Docker 有限操作结果"/>
        <TextBlock Grid.Row="7" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Page>
