<Page
    x:Class="WinShell.App.Features.Docker.DockerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docker="using:WinShell.Core.Docker"
    Loaded="Page_Loaded">
    <Grid
        Padding="{StaticResource WinShellPagePadding}"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="2*" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Spacing="4">
            <TextBlock
                Text="Docker"
                Style="{StaticResource WinShellPageTitleStyle}" />
            <TextBlock
                Text="选择远程容器，打开终端或查看日志。"
                Style="{StaticResource WinShellPageDescriptionStyle}" />
        </StackPanel>
        <Grid
            Grid.Row="1"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="ProfilesSelector"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                DisplayMemberPath="DisplayName"
                HorizontalAlignment="Stretch"
                PlaceholderText="选择 SSH 连接"
                AutomationProperties.Name="Docker 服务器 SSH 配置"
                IsEnabled="{Binding CanAct}" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                Content="验证 / 刷新"
                Click="Refresh_Click"
                IsEnabled="{Binding CanAct}"
                AutomationProperties.Name="验证服务器 Docker 并刷新最近 32 个容器" />
        </Grid>
        <Border
            Grid.Row="2"
            Style="{StaticResource WinShellCardStyle}"
            Padding="0">
            <ListView
                x:Name="ContainerList"
                ItemsSource="{Binding Containers}"
                SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                SelectionMode="Single"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="最近 32 个 Docker 容器">
                <ListView.ItemTemplate>
                    <DataTemplate
                        x:DataType="docker:DockerContainerSummary">
                        <StackPanel
                            Spacing="4"
                            Padding="8">
                            <TextBlock
                                Text="{Binding Names}"
                                Style="{StaticResource WinShellSectionTitleStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding Image}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding Status}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding Ports}"
                                Style="{StaticResource WinShellPageDescriptionStyle}" />
                            <TextBlock
                                Text="{Binding Id}"
                                FontFamily="Cascadia Mono"
                                FontSize="12"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <Grid
            Grid.Row="3"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="TerminalShellSelector"
                ItemsSource="{Binding TerminalShells}"
                SelectedItem="{Binding SelectedShell, Mode=TwoWay}"
                Header="容器 Shell"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="容器交互终端 shell"
                ToolTipService.ToolTip="Sh 使用 /bin/sh，Bash 使用 /bin/bash" />
            <Button
                x:Name="OpenTerminalButton"
                Grid.Column="1"
                Content="打开终端"
                Click="Terminal_Click"
                IsEnabled="{Binding CanOpenTerminal}"
                VerticalAlignment="Bottom"
                Style="{ThemeResource AccentButtonStyle}"
                AutomationProperties.Name="在终端工作区打开选中容器的交互终端" />
        </Grid>
        <StackPanel
            Grid.Row="4"
            Spacing="8">
            <CommandBar
                DefaultLabelPosition="Right"
                AutomationProperties.Name="容器操作">
                <AppBarButton
                    Icon="Document"
                    Label="日志"
                    Click="Logs_Click"
                    IsEnabled="{Binding CanAct}"
                    AutomationProperties.Name="读取选中容器最近 200 行日志" />
                <AppBarButton
                    Icon="Play"
                    Label="启动"
                    Click="Start_Click"
                    IsEnabled="{Binding CanAct}" />
                <AppBarButton
                    Icon="Cancel"
                    Label="取消"
                    Click="Cancel_Click"
                    IsEnabled="{Binding IsBusy}" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        Icon="Stop"
                        Label="停止…"
                        Click="Stop_Click"
                        IsEnabled="{Binding CanAct}" />
                    <AppBarButton
                        Icon="Refresh"
                        Label="重启…"
                        Click="Restart_Click"
                        IsEnabled="{Binding CanAct}" />
                    <AppBarButton
                        Icon="Refresh"
                        Label="刷新连接配置"
                        Click="Reload_Click"
                        IsEnabled="{Binding CanAct}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <Expander
                Header="一次性命令与服务器要求"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <StackPanel
                    Spacing="8">
                    <TextBlock
                        Text="仅支持 Linux / POSIX。服务器需已安装 Docker CLI，SSH 账号需有 /var/run/docker.sock 权限。"
                        Style="{StaticResource WinShellPageDescriptionStyle}" />
                    <TextBox
                        Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Header="一次性容器命令"
                        MaxLength="4096"
                        AutomationProperties.Name="一次性容器命令"
                        ToolTipService.ToolTip="使用 /bin/sh -c，最多 4096 UTF-8 字节" />
                    <Button
                        Content="执行…"
                        Click="Command_Click"
                        IsEnabled="{Binding CanAct}"
                        AutomationProperties.Name="确认执行一次性容器命令" />
                </StackPanel>
            </Expander>
        </StackPanel>
        <TextBox
            Grid.Row="5"
            Text="{Binding Output, Mode=OneWay}"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Header="操作结果"
            FontFamily="Cascadia Mono"
            AutomationProperties.Name="Docker 有限操作结果"
            ToolTipService.ToolTip="标准输出最多 32 KiB，错误输出最多 16 KiB" />
        <TextBlock
            Grid.Row="6"
            Text="{Binding Status}"
            Style="{StaticResource WinShellStatusTextStyle}" />
    </Grid>
</Page>