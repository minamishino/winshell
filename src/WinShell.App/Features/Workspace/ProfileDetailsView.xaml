<UserControl
    x:Class="WinShell.App.Features.Workspace.ProfileDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinShell.App.Features.Workspace"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:ProfileTabViewModel, IsDesignTimeCreatable=False}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource WinShellPagePadding}" Spacing="16">
            <TextBlock Text="配置详情" Style="{StaticResource WinShellPageTitleStyle}"/>
            <TextBlock Text="只读快照；修改配置后重新打开可查看最新内容。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBox Header="连接名称" AutomationProperties.Name="连接名称，只读" Text="{Binding Path=Profile.DisplayName}" IsReadOnly="True"/>
            <TextBox Header="协议" AutomationProperties.Name="协议，只读" Text="{Binding Path=Profile.Protocol}" IsReadOnly="True"/>
            <TextBox Header="主机" AutomationProperties.Name="主机，只读" Text="{Binding Path=Profile.Host}" IsReadOnly="True"/>
            <TextBox Header="端口" AutomationProperties.Name="端口，只读" Text="{Binding Path=Profile.Port}" IsReadOnly="True"/>
            <TextBox Header="用户名" AutomationProperties.Name="用户名，只读" Text="{Binding Path=Profile.UserName}" IsReadOnly="True"/>
            <TextBox Header="分组" AutomationProperties.Name="分组，只读" Text="{Binding Path=Profile.GroupName}" IsReadOnly="True"/>
            <TextBox Header="认证方式" AutomationProperties.Name="认证方式，只读" Text="{Binding Path=Profile.AuthenticationMethod}" IsReadOnly="True"/>
            <TextBox Header="私钥路径" AutomationProperties.Name="私钥路径，只读" Text="{Binding Path=Profile.PrivateKeyPath}" IsReadOnly="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
