<Page
    x:Class="WinShell.App.Features.Ssh.SshSessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ssh="using:WinShell.App.Features.Ssh">
    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="SSH 连接工作区 · 交互式终端尚未接入" TextWrapping="Wrap" Style="{ThemeResource SubtitleTextBlockStyle}"/>
        <Grid Grid.Row="1">
            <TabView x:Name="SessionTabs" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False"
                     TabItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     TabCloseRequested="SessionTabs_TabCloseRequested" SelectionChanged="SessionTabs_SelectionChanged" AutomationProperties.Name="SSH 会话标签">
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="ssh:SshSessionViewModel">
                        <TabViewItem Header="{Binding Title}" IsClosable="True" Loaded="SessionTab_Loaded" AutomationProperties.Name="{Binding Title}">
                            <ssh:SshSessionView DataContext="{x:Bind}" Loaded="SessionView_Loaded"/>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
            </TabView>
            <TextBlock x:Name="EmptyMessage" Text="请从连接配置列表选择已保存的 SSH 配置，点击“连接 SSH”。" TextWrapping="Wrap" Margin="24,64,24,24" VerticalAlignment="Top" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Page>
