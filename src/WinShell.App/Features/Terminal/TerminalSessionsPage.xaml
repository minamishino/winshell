<Page x:Class="WinShell.App.Features.Terminal.TerminalSessionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinShell.App.Features.Terminal"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:TerminalSessionsViewModel, IsDesignTimeCreatable=False}"
      xmlns:terminal="using:WinShell.App.Features.Terminal">
    <Grid Padding="{StaticResource WinShellPagePadding}" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <CommandBar x:Name="TerminalCommands" DefaultLabelPosition="Collapsed" HorizontalAlignment="Left" Background="Transparent" Opened="Popup_Opened" Closed="Popup_Closed" AutomationProperties.Name="终端操作">
            <AppBarButton Icon="AllApps" Label="其他会话" ToolTipService.ToolTip="其他会话" AutomationProperties.Name="其他终端会话">
                <AppBarButton.Flyout>
                    <!-- Used by the runtime UI checks through FindName("NewSessionFlyout"). -->
                    <!-- ReSharper disable once UnusedMember.Local -->
                    <Flyout x:Name="NewSessionFlyout" Opened="Popup_Opened" Closed="Popup_Closed">
                        <StackPanel Spacing="16" MinWidth="240" MaxWidth="320">
                            <TextBlock Text="新建会话" Style="{StaticResource WinShellSectionTitleStyle}"/>
                            <Button Content="PowerShell" Click="PowerShell_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="新建 PowerShell 终端"/>
                            <StackPanel Spacing="8">
                                <ComboBox x:Name="Distributions" Header="WSL 发行版" PlaceholderText="选择发行版" HorizontalAlignment="Stretch" DropDownOpened="Popup_Opened" DropDownClosed="Popup_Closed" AutomationProperties.Name="WSL 发行版"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="打开 WSL" Click="Wsl_Click" AutomationProperties.Name="打开所选 WSL 发行版"/>
                                    <Button Content="刷新" Click="RefreshWsl_Click" AutomationProperties.Name="刷新 WSL 发行版"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Copy" Label="复制" Click="Copy_Click" AutomationProperties.Name="复制终端选区"/>
            <AppBarButton Icon="Paste" Label="粘贴" Click="Paste_Click" AutomationProperties.Name="粘贴到终端"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Refresh" Label="重新连接" Click="Reconnect_Click" AutomationProperties.Name="重新连接终端"/>
                <AppBarButton Icon="Cancel" Label="关闭 / 取消" Click="Close_Click" AutomationProperties.Name="关闭或取消当前终端"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <!-- Used by the runtime UI checks through FindName("SessionTabs"). -->
        <!-- ReSharper disable once UnusedMember.Local -->
        <TabView x:Name="SessionTabs" Grid.Row="1" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False"
            TabItemsSource="{Binding Path=Tabs}" SelectedItem="{Binding Path=SelectedTab, Mode=TwoWay}"
            TabCloseRequested="Tabs_CloseRequested" SelectionChanged="Tabs_SelectionChanged" AutomationProperties.Name="交互终端标签">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="terminal:TerminalTabViewModel"><TabViewItem Header="{Binding Path=Title}" IsClosable="True" AutomationProperties.Name="{Binding Path=Title}"/></DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
        <Grid x:Name="TerminalHosts" Grid.Row="2" MinHeight="160" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <TextBlock x:Name="EmptyMessage" Text="新建终端" TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
        <ScrollViewer Grid.Row="2" MaxHeight="480" VerticalAlignment="Top" IsHitTestVisible="{Binding Path=SelectedTab.IsClosing, FallbackValue=False}">
            <TextBlock Text="{Binding Path=SelectedTab.DiagnosticText, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono" AutomationProperties.Name="终端结束诊断，最多保留最后16KiB输出"/>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="{Binding Path=SelectedTab.TargetDescription, FallbackValue=''}" Visibility="{Binding Path=SelectedTab.TargetDescription, FallbackValue=Collapsed, Converter={StaticResource WinShellTextVisibility}}" Style="{StaticResource WinShellPageDescriptionStyle}" FontSize="12" IsTextSelectionEnabled="True"/>
            <TextBlock Text="{Binding Path=SelectedTab.Status, FallbackValue=''}" Visibility="{Binding Path=SelectedTab.Status, FallbackValue=Collapsed, Converter={StaticResource WinShellTextVisibility}}" Style="{StaticResource WinShellStatusTextStyle}" FontSize="12"/>
            <TextBlock x:Name="Feedback" Visibility="{Binding Path=Text, ElementName=Feedback, Converter={StaticResource WinShellTextVisibility}}" Style="{StaticResource WinShellStatusTextStyle}" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>
