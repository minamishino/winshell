<Page x:Class="WinShell.App.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="设置" Style="{ThemeResource SubtitleTextBlockStyle}"/>
        <Pivot x:Name="Sections" Grid.Row="1" AutomationProperties.Name="设置类别">
            <PivotItem Header="外观">
                <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                    <ComboBox x:Name="ThemeSelector" Header="应用主题" AutomationProperties.Name="应用主题"
                        Width="240" IsEnabled="{Binding CanEdit}" SelectionChanged="Theme_SelectionChanged">
                        <ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="重新加载" Click="Reload_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="重新加载外观设置"/>
                        <Button Content="保存外观" Click="Save_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="保存外观设置"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </PivotItem>
            <PivotItem Header="AI / MCP 权限">
                <ContentControl x:Name="PermissionsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
