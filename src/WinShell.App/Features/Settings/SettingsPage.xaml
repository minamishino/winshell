<Page x:Class="WinShell.App.Features.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinShell.App.Features.Settings"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
      SizeChanged="Page_SizeChanged">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="设置" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="应用设置更改后自动保存；MCP 权限需要单独保存。"/>
            <Button Grid.Column="1" Style="{StaticResource WinShellIconButtonStyle}" Click="Reload_Click" IsEnabled="{Binding Path=CanEdit}" ToolTipService.ToolTip="重新加载设置" AutomationProperties.Name="重新加载设置"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
        </Grid>
        <Grid x:Name="SettingsLayout" Grid.Row="1" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="SettingsSidebar" Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="SettingsSearch" PlaceholderText="搜索设置" TextChanged="Search_TextChanged" AutomationProperties.Name="搜索设置"/>
                <ListView x:Name="Categories" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="Category_SelectionChanged" SelectionMode="Single" Visibility="Collapsed" AutomationProperties.Name="设置类别"/>
                <ComboBox x:Name="CompactCategories" Grid.Row="1" ItemsSource="{Binding Path=ItemsSource, ElementName=Categories}" SelectedItem="{Binding Path=SelectedItem, ElementName=Categories, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" AutomationProperties.Name="设置类别"/>
            </Grid>
            <Grid x:Name="SettingsContentHost" Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="640"/></Grid.ColumnDefinitions>
            <!-- Used by the runtime UI checks through FindName("SettingsContent"). -->
            <!-- ReSharper disable once UnusedMember.Local -->
            <ScrollViewer x:Name="SettingsContent" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="CategoryTitle" Style="{StaticResource WinShellSectionTitleStyle}"/>
                    <StackPanel x:Name="GeneralPanel" Spacing="12">
                        <ComboBox x:Name="StartupSelector" Header="启动页面" HorizontalAlignment="Stretch" IsEnabled="{Binding Path=CanEdit}" SelectionChanged="Startup_SelectionChanged" ToolTipService.ToolTip="启动只显示页面，终端和网络连接由你主动打开。" AutomationProperties.Name="启动时显示"><ComboBoxItem Content="终端"/><ComboBoxItem Content="连接"/></ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="AppearancePanel" Spacing="12" Visibility="Collapsed">
                        <ComboBox x:Name="ThemeSelector" Header="应用主题" HorizontalAlignment="Stretch" IsEnabled="{Binding Path=CanEdit}" SelectionChanged="Theme_SelectionChanged" AutomationProperties.Name="应用主题"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="TerminalPanel" Spacing="12" Visibility="Collapsed">
                        <ComboBox x:Name="FontSelector" Header="终端字体" HorizontalAlignment="Stretch" IsEnabled="{Binding Path=CanEdit}" SelectionChanged="Font_SelectionChanged" ToolTipService.ToolTip="使用 Windows 已安装字体；未安装时可能使用替代字体。" AutomationProperties.Name="终端字体"><ComboBoxItem Content="Cascadia Code"/><ComboBoxItem Content="Consolas"/></ComboBox>
                        <NumberBox x:Name="FontSizeSelector" Header="字号" Minimum="8" Maximum="32" SmallChange="1" LargeChange="4" SpinButtonPlacementMode="Inline" IsEnabled="{Binding Path=CanEdit}" ValueChanged="FontSize_ValueChanged" ToolTipService.ToolTip="终端字号：8–32" AutomationProperties.Name="终端字号"/>
                        <ComboBox x:Name="CursorSelector" Header="光标样式" HorizontalAlignment="Stretch" IsEnabled="{Binding Path=CanEdit}" SelectionChanged="Cursor_SelectionChanged" AutomationProperties.Name="光标样式"><ComboBoxItem Content="闪烁方块"/><ComboBoxItem Content="固定方块"/><ComboBoxItem Content="闪烁下划线"/><ComboBoxItem Content="固定下划线"/><ComboBoxItem Content="闪烁竖线"/><ComboBoxItem Content="固定竖线"/></ComboBox>
                        <ComboBox x:Name="DefaultShellSelector" Header="默认终端" HorizontalAlignment="Stretch" IsEnabled="{Binding Path=CanEdit}" SelectionChanged="DefaultShell_SelectionChanged" ToolTipService.ToolTip="新建终端按钮使用的默认目标。选择 WSL 前先填写发行版名称。" AutomationProperties.Name="默认终端目标"><ComboBoxItem Content="PowerShell"/><ComboBoxItem Content="WSL（指定发行版）"/></ComboBox>
                        <TextBox x:Name="WslDistributionText" Header="WSL 发行版" PlaceholderText="例如 Ubuntu" MaxLength="128" IsEnabled="{Binding Path=CanEdit}" LostFocus="WslDistribution_LostFocus" KeyDown="WslDistribution_KeyDown" ToolTipService.ToolTip="按 Enter 或离开输入框保存；不会查询或启动 WSL。" AutomationProperties.Name="默认 WSL 发行版名称"/>
                        <ToggleSwitch x:Name="CloseSwitch" Header="关闭终端前确认" IsEnabled="{Binding Path=CanEdit}" Toggled="Close_Toggled" AutomationProperties.Name="关闭终端标签前确认"/>
                    </StackPanel>
                    <StackPanel x:Name="InputPanel" Spacing="8" Visibility="Collapsed">
                        <ToggleSwitch x:Name="MultilineSwitch" Header="多行粘贴前确认" IsEnabled="{Binding Path=CanEdit}" Toggled="Multiline_Toggled" AutomationProperties.Name="多行粘贴前确认"/>
                        <TextBlock Text="换行可能立即执行命令。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="ConnectionsPanel" Visibility="Collapsed"><Button x:Name="ConnectionsNavigation" Content="管理连接配置" Style="{StaticResource WinShellToolbarButtonStyle}" Click="Connections_Click" ToolTipService.ToolTip="管理协议、主机、端口、认证方式和凭据。" AutomationProperties.Name="管理连接配置"/></StackPanel>
                    <StackPanel x:Name="FilesPanel" Visibility="Collapsed"><Button x:Name="FilesNavigation" Content="打开文件传输" Style="{StaticResource WinShellToolbarButtonStyle}" Click="Files_Click" ToolTipService.ToolTip="使用已保存的 SFTP、FTP 或 FTPS 连接。" AutomationProperties.Name="打开文件传输"/></StackPanel>
                    <StackPanel x:Name="McpPanel" Spacing="16" Visibility="Collapsed"><ContentControl x:Name="McpServiceHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch"/><ContentControl x:Name="PermissionsHost" HorizontalContentAlignment="Stretch"/></StackPanel>
                    <TextBlock x:Name="NoResults" Text="未找到匹配的设置。" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="ValidationFeedback" TextWrapping="Wrap" Visibility="{Binding Path=Text, ElementName=ValidationFeedback, Converter={StaticResource WinShellTextVisibility}}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding Path=Status}" TextWrapping="Wrap" Visibility="{Binding Path=Status, Converter={StaticResource WinShellTextVisibility}}" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="RetrySave" Visibility="Collapsed" Content="重试保存" Style="{StaticResource WinShellToolbarButtonStyle}" Click="Save_Click" IsEnabled="{Binding Path=CanEdit}" AutomationProperties.Name="重试保存设置"/>
        </StackPanel>
    </Grid>
</Page>
