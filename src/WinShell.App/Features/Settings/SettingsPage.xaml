<Page x:Class="WinShell.App.Features.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Padding="24" RowSpacing="16">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="设置" Style="{ThemeResource SubtitleTextBlockStyle}"/>
<Grid Grid.Row="1" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBox x:Name="SettingsSearch" PlaceholderText="搜索设置" TextChanged="Search_TextChanged" AutomationProperties.Name="搜索设置"/>
<ListView x:Name="Categories" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="Category_SelectionChanged" SelectionMode="Single" AutomationProperties.Name="设置类别"/>
</Grid>
<ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Stretch">
<TextBlock x:Name="CategoryTitle" Style="{ThemeResource SubtitleTextBlockStyle}"/>
<StackPanel x:Name="GeneralPanel" Spacing="16">
<ComboBox x:Name="StartupSelector" Header="启动时显示" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}" SelectionChanged="Startup_SelectionChanged" AutomationProperties.Name="启动时显示"><ComboBoxItem Content="终端"/><ComboBoxItem Content="连接"/></ComboBox>
<TextBlock Text="启动只显示页面。终端和网络连接始终由你主动打开。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
</StackPanel>
<StackPanel x:Name="AppearancePanel" Spacing="16" Visibility="Collapsed">
<ComboBox x:Name="ThemeSelector" Header="应用主题" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}" SelectionChanged="Theme_SelectionChanged" AutomationProperties.Name="应用主题"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
</StackPanel>
<StackPanel x:Name="TerminalPanel" Spacing="16" Visibility="Collapsed">
<ComboBox x:Name="FontSelector" Header="终端字体" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}" SelectionChanged="Font_SelectionChanged" AutomationProperties.Name="终端字体"><ComboBoxItem Content="Cascadia Code"/><ComboBoxItem Content="Consolas"/></ComboBox>
<TextBlock Text="字体来自 Windows 已安装字体。未安装所选字体时，终端引擎可能使用替代字体。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<NumberBox x:Name="FontSizeSelector" Header="终端字号（8–32）" Minimum="8" Maximum="32" SmallChange="1" LargeChange="4" SpinButtonPlacementMode="Inline" IsEnabled="{Binding CanEdit}" ValueChanged="FontSize_ValueChanged" AutomationProperties.Name="终端字号"/>
<ComboBox x:Name="CursorSelector" Header="光标样式" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}" SelectionChanged="Cursor_SelectionChanged" AutomationProperties.Name="光标样式"><ComboBoxItem Content="闪烁方块"/><ComboBoxItem Content="固定方块"/><ComboBoxItem Content="闪烁下划线"/><ComboBoxItem Content="固定下划线"/><ComboBoxItem Content="闪烁竖线"/><ComboBoxItem Content="固定竖线"/></ComboBox>
<ComboBox x:Name="DefaultShellSelector" Header="新建按钮的默认目标" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}" SelectionChanged="DefaultShell_SelectionChanged" AutomationProperties.Name="默认终端目标"><ComboBoxItem Content="PowerShell"/><ComboBoxItem Content="WSL（指定发行版）"/></ComboBox>
<TextBox x:Name="WslDistributionText" Header="默认 WSL 发行版名称" PlaceholderText="例如 Ubuntu" MaxLength="128" IsEnabled="{Binding CanEdit}" LostFocus="WslDistribution_LostFocus" KeyDown="WslDistribution_KeyDown" AutomationProperties.Name="默认 WSL 发行版名称"/>
<TextBlock Text="先输入发行版名称，再选择 WSL。按 Enter 或离开输入框保存；设置不会查询或启动 WSL。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<ToggleSwitch x:Name="CloseSwitch" Header="关闭终端标签前确认" IsEnabled="{Binding CanEdit}" Toggled="Close_Toggled" AutomationProperties.Name="关闭终端标签前确认"/>
</StackPanel>
<StackPanel x:Name="InputPanel" Spacing="16" Visibility="Collapsed">
<ToggleSwitch x:Name="MultilineSwitch" Header="粘贴包含换行的内容前确认" IsEnabled="{Binding CanEdit}" Toggled="Multiline_Toggled" AutomationProperties.Name="多行粘贴前确认"/>
<TextBlock Text="使用终端工具栏复制和粘贴。包含换行的内容可能立即执行命令。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
</StackPanel>
<StackPanel x:Name="ConnectionsPanel" Spacing="16" Visibility="Collapsed"><TextBlock Text="协议、主机、端口、认证方式和凭据按连接配置保存。" TextWrapping="Wrap"/><Button x:Name="ConnectionsNavigation" Content="管理连接配置" Click="Connections_Click" AutomationProperties.Name="管理连接配置"/></StackPanel>
<StackPanel x:Name="FilesPanel" Spacing="16" Visibility="Collapsed"><TextBlock Text="从文件页面选择已保存的 SFTP、FTP 或 FTPS 连接并管理传输。" TextWrapping="Wrap"/><Button x:Name="FilesNavigation" Content="打开文件传输" Click="Files_Click" AutomationProperties.Name="打开文件传输"/></StackPanel>
<StackPanel x:Name="McpPanel" Spacing="16" Visibility="Collapsed"><ContentControl x:Name="McpServiceHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch"/><ContentControl x:Name="PermissionsHost" HorizontalContentAlignment="Stretch"/></StackPanel>
<TextBlock x:Name="NoResults" Text="未找到匹配的设置。" Visibility="Collapsed" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></Grid>
<StackPanel Grid.Row="2" Spacing="8"><TextBlock Text="更改后自动保存。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ValidationFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
<StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="RetrySave" Visibility="Collapsed" Content="重试保存" Click="Save_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="重试保存设置"/><Button Content="重新加载" Click="Reload_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="重新加载设置"/></StackPanel></StackPanel>
</Grid></Page>
