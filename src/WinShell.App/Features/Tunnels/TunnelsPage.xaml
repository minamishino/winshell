<Page x:Class="WinShell.App.Features.Tunnels.TunnelsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="24" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="8">
   <TextBlock Text="SSH 隧道" Style="{ThemeResource TitleTextBlockStyle}"/>
   <TextBlock Text="保存定义后手动启动。监听请求固定为 127.0.0.1；远程实际暴露范围仍取决于 SSH 服务器策略。动态 SOCKS 无认证，仅供本机使用。" TextWrapping="Wrap"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" MaxHeight="340" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Spacing="8">
    <ComboBox x:Name="Profiles" Header="已保存的 SSH 配置" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch"/>
    <TextBox x:Name="TunnelName" Header="隧道名称" MaxLength="128"/>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="Kind" Header="转发类型" SelectedIndex="0" SelectionChanged="Kind_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="本地转发"/><ComboBoxItem Content="远程转发"/><ComboBoxItem Content="动态 SOCKS"/></ComboBox>
     <NumberBox x:Name="ListenPort" Grid.Column="1" Header="监听端口（0 自动分配）" Minimum="0" Maximum="65535" Value="0" SpinButtonPlacementMode="Compact"/>
    </Grid>
    <Grid x:Name="TargetFields" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBox x:Name="TargetHost" Header="目标主机（远程转发需填写本机 IP）" Text="127.0.0.1" MaxLength="255"/>
     <NumberBox x:Name="TargetPort" Grid.Column="1" Header="目标端口" Minimum="1" Maximum="65535" Value="22" SpinButtonPlacementMode="Compact"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button x:Name="SaveButton" Content="保存定义" Click="Save_Click"/><Button Content="新建" Click="New_Click"/><Button Content="刷新配置" Click="Reload_Click"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ListView x:Name="Definitions" ItemsSource="{Binding Rows}" SelectionChanged="Definitions_SelectionChanged" AutomationProperties.Name="已保存的 SSH 隧道" SelectionMode="Single">
    <ListView.ItemTemplate><DataTemplate><StackPanel Padding="4" Spacing="4">
     <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Kind}"/><TextBlock Text="{Binding Status}"/></StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="实际端口："/><TextBlock Text="{Binding BoundPort}"/><TextBlock Text="活动连接："/><TextBlock Text="{Binding ActiveConnections}"/></StackPanel>
     <TextBlock Text="{Binding Error}" TextWrapping="Wrap"/>
    </StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button x:Name="StartButton" Content="启动" Click="Start_Click"/><Button x:Name="StopButton" Content="停止 / 取消启动" Click="Stop_Click"/><Button x:Name="DeleteButton" Content="删除定义" Click="Delete_Click"/></StackPanel>
  </Grid>
  <TextBlock x:Name="Feedback" Grid.Row="3" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Page>
