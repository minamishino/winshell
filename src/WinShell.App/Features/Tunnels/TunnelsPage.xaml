<Page x:Class="WinShell.App.Features.Tunnels.TunnelsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinShell.App.Features.Tunnels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:TunnelsViewModel, IsDesignTimeCreatable=False}">
    <Grid Padding="{StaticResource WinShellPagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Used by the runtime UI checks through FindName("TunnelActions"). -->
        <!-- ReSharper disable once UnusedMember.Local -->
        <Grid x:Name="TunnelActions" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="隧道" Style="{StaticResource WinShellPageTitleStyle}" VerticalAlignment="Center" />
            <Button x:Name="StartButton" Grid.Column="1" Content="启动" Click="Start_Click"
                    Style="{ThemeResource AccentButtonStyle}" MinHeight="32" Padding="10,4" VerticalAlignment="Center"
                    AutomationProperties.Name="启动所选隧道" />
            <Button x:Name="StopButton" Grid.Column="2" Content="停止" Click="Stop_Click"
                    Style="{StaticResource WinShellToolbarButtonStyle}"
                    ToolTipService.ToolTip="停止或取消所选隧道" AutomationProperties.Name="停止或取消所选隧道" />
            <Button Grid.Column="3" Content="新建" Click="New_Click"
                    Style="{StaticResource WinShellToolbarButtonStyle}" AutomationProperties.Name="新建隧道" />
            <Button x:Name="DeleteButton" Grid.Column="4" Content="删除…" Click="Delete_Click"
                    Style="{StaticResource WinShellToolbarButtonStyle}" AutomationProperties.Name="删除所选隧道定义" />
            <Button Grid.Column="5" Style="{StaticResource WinShellIconButtonStyle}"
                    ToolTipService.ToolTip="隧道选项" AutomationProperties.Name="更多隧道选项">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="320" Spacing="12">
                            <Button Content="刷新连接配置" Click="Reload_Click" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="刷新隧道 SSH 连接配置" />
                            <TextBlock Text="监听范围" Style="{StaticResource WinShellSectionTitleStyle}" />
                            <TextBlock Text="监听请求固定为 127.0.0.1；远程实际暴露范围仍取决于 SSH 服务器策略。动态 SOCKS 无认证，仅供本机使用。"
                                       Style="{StaticResource WinShellPageDescriptionStyle}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <Expander x:Name="TunnelEditor" Grid.Row="1" Header="隧道配置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="Profiles" Header="SSH 连接" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch"
                                  SelectionChanged="Profiles_SelectionChanged"
                                  VerticalAlignment="Bottom" AutomationProperties.Name="隧道 SSH 连接" />
                        <TextBox x:Name="TunnelName" Grid.Column="1" Header="名称" MaxLength="128" VerticalAlignment="Bottom"
                                 AutomationProperties.Name="隧道名称" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="Kind" Header="转发类型" SelectedIndex="0" SelectionChanged="Kind_SelectionChanged"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom" AutomationProperties.Name="隧道转发类型">
                            <ComboBoxItem Content="本地转发" /><ComboBoxItem Content="远程转发" /><ComboBoxItem Content="动态 SOCKS" />
                        </ComboBox>
                        <NumberBox x:Name="ListenPort" Grid.Column="1" Header="监听端口" Minimum="0" Maximum="65535" Value="0"
                                   SpinButtonPlacementMode="Compact" VerticalAlignment="Bottom"
                                   ToolTipService.ToolTip="填写 0 自动分配端口" AutomationProperties.Name="监听端口，0 自动分配" />
                    </Grid>
                    <Grid x:Name="TargetFields" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetHost" Header="目标主机" Text="127.0.0.1" MaxLength="255" VerticalAlignment="Bottom"
                                 ToolTipService.ToolTip="远程转发需填写本机 IP" AutomationProperties.Name="目标主机，远程转发需填写本机 IP" />
                        <NumberBox x:Name="TargetPort" Grid.Column="1" Header="目标端口" Minimum="1" Maximum="65535" Value="22"
                                   SpinButtonPlacementMode="Compact" VerticalAlignment="Bottom" AutomationProperties.Name="目标端口" />
                    </Grid>
                    <Button x:Name="SaveButton" Content="保存定义" Click="Save_Click" IsEnabled="False"
                            Style="{StaticResource WinShellToolbarButtonStyle}" ToolTipService.ToolTip="保存后手动启动隧道"
                            AutomationProperties.Name="保存隧道定义" />
                </StackPanel>
            </ScrollViewer>
        </Expander>
        <Border Grid.Row="2" Style="{StaticResource WinShellCardStyle}" Padding="0">
            <ListView x:Name="Definitions" ItemsSource="{Binding Path=Rows}" SelectionChanged="Definitions_SelectionChanged"
                      HorizontalContentAlignment="Stretch" AutomationProperties.Name="已保存的 SSH 隧道" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,6" RowSpacing="4" ColumnSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Path=Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path=Name}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Path=Status}" />
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding Path=Kind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="端口 " /><Run Text="{Binding Path=BoundPort}" /><Run Text=" · 连接 " /><Run Text="{Binding Path=ActiveConnections}" />
                            </TextBlock>
                            <TextBlock Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Path=Error}" TextWrapping="Wrap"
                                       Visibility="{Binding Path=Error, Converter={StaticResource WinShellTextVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <TextBlock x:Name="Feedback" Grid.Row="3" Style="{StaticResource WinShellStatusTextStyle}" />
    </Grid>
</Page>
