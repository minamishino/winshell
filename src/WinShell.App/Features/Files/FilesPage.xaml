<Page x:Class="WinShell.App.Features.Files.FilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinShell.App.Features.Files"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:FilesViewModel, IsDesignTimeCreatable=False}"
      xmlns:local="using:WinShell.App.Features.Files"
      xmlns:files="using:WinShell.Core.Files">
    <Page.Resources>
        <local:DirectoryLabelConverter x:Key="DirectoryLabel"/>
        <local:FileGlyphConverter x:Key="FileGlyph"/>
    </Page.Resources>
    <Grid Padding="{StaticResource WinShellPagePadding}" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="文件" Style="{StaticResource WinShellPageTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ComboBox x:Name="Profiles" Grid.Column="1" PlaceholderText="选择连接" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsEnabled="{Binding Path=CanConnect}" AutomationProperties.Name="文件连接配置"/>
            <Button x:Name="ConnectButton" Grid.Column="2" Content="连接" Click="Connect_Click" Style="{StaticResource WinShellToolbarButtonStyle}" IsEnabled="{Binding Path=CanConnect}" AutomationProperties.Name="连接远端文件"/>
            <Button Grid.Column="3" Style="{StaticResource WinShellIconButtonStyle}" ToolTipService.ToolTip="连接选项" AutomationProperties.Name="文件连接选项">
                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                <Button.Flyout><MenuFlyout>
                    <MenuFlyoutItem Text="断开连接" Click="Disconnect_Click" IsEnabled="{Binding Path=CanBrowse}"/>
                    <MenuFlyoutItem Text="刷新连接配置" Click="Reload_Click" IsEnabled="{Binding Path=CanConnect}"/>
                </MenuFlyout></Button.Flyout>
            </Button>
        </Grid>
        <!-- Used by the runtime UI checks through FindName("FileToolbar"). -->
        <!-- ReSharper disable once UnusedMember.Local -->
        <Grid x:Name="FileToolbar" Grid.Row="1" ColumnSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Style="{StaticResource WinShellIconButtonStyle}" Click="Up_Click" IsEnabled="{Binding Path=CanBrowse}" ToolTipService.ToolTip="上一级" AutomationProperties.Name="上一级目录"><FontIcon Glyph="&#xE74A;" FontSize="16"/></Button>
            <TextBox x:Name="RemotePath" Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding Path=CanBrowse}" Text="{Binding Path=Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" KeyDown="Path_KeyDown" AutomationProperties.Name="远端路径"/>
            <Button x:Name="GoButton" Grid.Column="2" Style="{StaticResource WinShellIconButtonStyle}" Click="Go_Click" IsEnabled="{Binding Path=CanBrowse}" ToolTipService.ToolTip="转到路径（Enter）" AutomationProperties.Name="转到远端路径"><FontIcon Glyph="&#xE72A;" FontSize="16"/></Button>
            <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource WinShellIconButtonStyle}" Click="Refresh_Click" IsEnabled="{Binding Path=CanBrowse}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新远端目录"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
            <Button x:Name="DownloadButton" Grid.Column="4" Style="{StaticResource WinShellIconButtonStyle}" Click="Download_Click" IsEnabled="{Binding Path=CanBrowse}" ToolTipService.ToolTip="下载所选文件" AutomationProperties.Name="下载所选文件"><FontIcon Glyph="&#xE896;" FontSize="16"/></Button>
            <Button x:Name="UploadButton" Grid.Column="5" Style="{StaticResource WinShellIconButtonStyle}" Click="Upload_Click" IsEnabled="{Binding Path=CanBrowse}" ToolTipService.ToolTip="上传文件" AutomationProperties.Name="上传文件"><FontIcon Glyph="&#xE898;" FontSize="16"/></Button>
            <!-- Used by the runtime UI checks through FindName("TransferOptionsButton"). -->
            <!-- ReSharper disable once UnusedMember.Local -->
            <Button x:Name="TransferOptionsButton" Grid.Column="6" Style="{StaticResource WinShellIconButtonStyle}" ToolTipService.ToolTip="传输选项" AutomationProperties.Name="文件传输选项">
                <FontIcon Glyph="&#xE713;" FontSize="16"/>
                <Button.Flyout><Flyout>
                    <StackPanel Spacing="12" Width="260">
                        <TextBox x:Name="UploadName" Header="上传文件名" IsEnabled="{Binding Path=CanBrowse}" PlaceholderText="使用原文件名" MaxLength="4096" AutomationProperties.Name="上传远端文件名"/>
                        <TextBlock Text="{Binding Path=TransferSafety}" Style="{StaticResource WinShellPageDescriptionStyle}" FontSize="12"/>
                        <TextBlock Text="{Binding Path=ConnectionNotice}" Visibility="{Binding Path=ConnectionNotice, Converter={StaticResource WinShellTextVisibility}}" Style="{StaticResource WinShellPageDescriptionStyle}" FontSize="12"/>
                    </StackPanel>
                </Flyout></Button.Flyout>
            </Button>
        </Grid>
        <!-- Used by the runtime UI checks through FindName("FileListPanel"). -->
        <!-- ReSharper disable once UnusedMember.Local -->
        <Border x:Name="FileListPanel" Grid.Row="2" Style="{StaticResource WinShellCardStyle}" Padding="0">
            <Grid>
                <ListView x:Name="Entries" ItemsSource="{Binding Path=Entries}" SelectionMode="Single" DoubleTapped="Entries_DoubleTapped" KeyDown="Entries_KeyDown" IsEnabled="{Binding Path=CanBrowse}" AutomationProperties.Name="远端目录条目" HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem" d:DataContext="{d:DesignInstance Type=files:RemoteFileEntry, IsDesignTimeCreatable=False}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="AutomationProperties.Name" Value="{Binding Path=Name}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Path=IsDirectory, Converter={StaticResource DirectoryLabel}}"/></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate x:DataType="files:RemoteFileEntry">
                        <Grid ColumnSpacing="12" Padding="8,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding Path=IsDirectory, Converter={StaticResource FileGlyph}}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding Path=IsDirectory, Converter={StaticResource DirectoryLabel}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Length}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="大小（字节）"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False" Visibility="{Binding Path=ShowConnectionPrompt, Converter={StaticResource WinShellBooleanVisibility}}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="选择连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Spacing="4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Status}" Visibility="{Binding Path=Status, Converter={StaticResource WinShellTextVisibility}}" Style="{StaticResource WinShellStatusTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Path=ProgressText}" Visibility="{Binding Path=ProgressText, Converter={StaticResource WinShellTextVisibility}}" FontSize="12" VerticalAlignment="Center"/>
                <Button x:Name="CancelButton" Grid.Column="2" Content="取消" Click="Cancel_Click" IsEnabled="{Binding Path=CanCancel}" Visibility="{Binding Path=CanCancel, Converter={StaticResource WinShellBooleanVisibility}}" Style="{StaticResource WinShellToolbarButtonStyle}"/>
            </Grid>
            <TextBlock x:Name="Feedback" Visibility="{Binding Path=Text, ElementName=Feedback, Converter={StaticResource WinShellTextVisibility}}" Style="{StaticResource WinShellStatusTextStyle}" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>
