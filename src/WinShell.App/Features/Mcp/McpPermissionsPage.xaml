<Page x:Class="WinShell.App.Features.Mcp.McpPermissionsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="0,8,0,0" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="AI / MCP 权限" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
  <TextBlock Grid.Row="1" TextWrapping="Wrap" Text="这些权限供同一 Windows 用户启动的本地 MCP 服务使用，不能识别某个指定 AI 客户端。允许执行任意 Shell 脚本可能修改或删除远端数据。撤销对新调用生效；已开始的操作仍需取消或等待结束（最长约 30 秒及连接清理时间）。"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
   <Button IsEnabled="{Binding CanEdit}" Content="重新加载" Click="Reload_Click" AutomationProperties.Name="重新加载 MCP 权限"/>
   <Button IsEnabled="{Binding CanEdit}" Content="保存权限" Click="Save_Click" AutomationProperties.Name="保存 MCP 权限"/>
   <Button IsEnabled="{Binding CanEdit}" Content="撤销全部" Click="Revoke_Click" AutomationProperties.Name="撤销全部 MCP 权限"/>
  </StackPanel>
  <ListView Grid.Row="3" ItemsSource="{Binding Profiles}" SelectionMode="None" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="SSH 配置 MCP 权限">
   <ListView.ItemTemplate><DataTemplate>
    <StackPanel Spacing="6" Padding="8">
     <TextBlock Text="{Binding Name}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
     <TextBlock Text="配置标识"/><TextBlock Text="{Binding ProfileIdentifier}" IsTextSelectionEnabled="True" AutomationProperties.Name="配置标识"/>
     <TextBlock Text="{Binding Target}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding KeyDescription}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <CheckBox IsEnabled="{Binding CanGrant}" Content="允许列出配置名称和标识" IsChecked="{Binding ListProfiles, Mode=TwoWay}" AutomationProperties.Name="{Binding MetadataLabel}"/>
     <CheckBox IsEnabled="{Binding CanGrant}" Content="允许执行任意 Shell 脚本" IsChecked="{Binding RunScript, Mode=TwoWay}" AutomationProperties.Name="{Binding ScriptLabel}"/>
     <CheckBox IsEnabled="{Binding CanGrant}" Content="允许读取 Docker 容器和日志" IsChecked="{Binding DockerRead, Mode=TwoWay}" AutomationProperties.Name="{Binding DockerReadLabel}"/>
     <CheckBox IsEnabled="{Binding CanGrant}" Content="允许启停和重启 Docker 容器" IsChecked="{Binding DockerControl, Mode=TwoWay}" AutomationProperties.Name="{Binding DockerControlLabel}"/>
     <CheckBox IsEnabled="{Binding CanGrant}" Content="允许在 Docker 容器执行任意命令" IsChecked="{Binding DockerExec, Mode=TwoWay}" AutomationProperties.Name="{Binding DockerExecLabel}"/>
    </StackPanel>
   </DataTemplate></ListView.ItemTemplate>
  </ListView>
  <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Page>
