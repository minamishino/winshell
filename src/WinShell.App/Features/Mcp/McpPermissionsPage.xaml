<Page x:Class="WinShell.App.Features.Mcp.McpPermissionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinShell.App.Features.Mcp"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:McpPermissionsViewModel, IsDesignTimeCreatable=False}">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="AI / MCP 权限" Style="{StaticResource WinShellSectionTitleStyle}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource WinShellPageDescriptionStyle}" Text="权限适用于同一 Windows 用户的所有本地 MCP 客户端。任意命令可能修改或删除远端数据。"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button IsEnabled="{Binding Path=CanEdit}" Style="{StaticResource WinShellIconButtonStyle}" Click="Reload_Click" ToolTipService.ToolTip="重新加载权限" AutomationProperties.Name="重新加载 MCP 权限"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
            <Button IsEnabled="{Binding Path=CanEdit}" Content="保存权限" Style="{StaticResource WinShellToolbarButtonStyle}" Click="Save_Click" AutomationProperties.Name="保存 MCP 权限"/>
            <Button IsEnabled="{Binding Path=CanEdit}" Content="撤销全部" Style="{StaticResource WinShellToolbarButtonStyle}" Click="Revoke_Click" ToolTipService.ToolTip="对新调用生效；已开始的操作需取消或等待结束，最长约 30 秒及连接清理时间。" AutomationProperties.Name="撤销全部 MCP 权限"/>
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{Binding Path=Profiles}" SelectionMode="None" IsEnabled="{Binding Path=CanEdit}" AutomationProperties.Name="SSH 配置 MCP 权限">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Path=Name}" Style="{StaticResource WinShellSectionTitleStyle}"/>
                            <TextBlock Text="{Binding Path=Target}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Path=ProfileIdentifier}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" AutomationProperties.Name="配置标识"/>
                            <TextBlock Text="{Binding Path=KeyDescription}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True"/>
                            <CheckBox IsEnabled="{Binding Path=CanGrant}" Content="列出配置名称和标识" IsChecked="{Binding Path=ListProfiles, Mode=TwoWay}" AutomationProperties.Name="{Binding Path=MetadataLabel}"/>
                            <CheckBox IsEnabled="{Binding Path=CanGrant}" Content="执行任意 Shell 脚本" IsChecked="{Binding Path=RunScript, Mode=TwoWay}" AutomationProperties.Name="{Binding Path=ScriptLabel}"/>
                            <CheckBox IsEnabled="{Binding Path=CanGrant}" Content="读取 Docker 容器和日志" IsChecked="{Binding Path=DockerRead, Mode=TwoWay}" AutomationProperties.Name="{Binding Path=DockerReadLabel}"/>
                            <CheckBox IsEnabled="{Binding Path=CanGrant}" Content="启停和重启 Docker 容器" IsChecked="{Binding Path=DockerControl, Mode=TwoWay}" AutomationProperties.Name="{Binding Path=DockerControlLabel}"/>
                            <CheckBox IsEnabled="{Binding Path=CanGrant}" Content="在 Docker 容器执行任意命令" IsChecked="{Binding Path=DockerExec, Mode=TwoWay}" AutomationProperties.Name="{Binding Path=DockerExecLabel}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="4" Text="{Binding Path=Status}" Style="{StaticResource WinShellStatusTextStyle}" Visibility="{Binding Path=Status, Converter={StaticResource WinShellTextVisibility}}"/>
    </Grid>
</Page>
