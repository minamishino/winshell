<Application
    x:Class="WinShell.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinShell.App.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Thickness x:Key="WinShellPagePadding">20,16</Thickness>
            <controls:TextVisibilityConverter x:Key="WinShellTextVisibility" />
            <controls:BooleanVisibilityConverter x:Key="WinShellBooleanVisibility" />
            <Style x:Key="WinShellToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="WinShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource WinShellToolbarButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="WinShellPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- Defined by Microsoft.WindowsAppSDK.WinUI 2.3.9 Themes/generic.xaml and loaded above. -->
            <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
            <Style x:Key="WinShellSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
            <Style x:Key="WinShellPageDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="WinShellStatusTextStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            </Style>
            <Style x:Key="WinShellCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style TargetType="controls:NativeTerminalControl">
                <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
