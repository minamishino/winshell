<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <TargetPlatformMinVersion>10.0.19045.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19045.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- C#/WinRT generates ABI vtables for the partial XAML controls and view models. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- HTTP companion is deployed as a separate process; no assembly reference enters App. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\winshell.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\winshell.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../WinShell.Mcp.Http/LocalMcpHttpTokenStore.cs" Link="Features/Mcp/LocalMcpHttpTokenStore.cs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <ProjectReference Include="..\WinShell.Infrastructure.Ssh\WinShell.Infrastructure.Ssh.csproj" />
    <ProjectReference Include="..\WinShell.Infrastructure.Ftp\WinShell.Infrastructure.Ftp.csproj" />
    <ProjectReference Include="..\WinShell.Core\WinShell.Core.csproj" />
    <ProjectReference Include="..\WinShell.Infrastructure.Windows\WinShell.Infrastructure.Windows.csproj" />
    <ProjectReference Include="../WinShell.Terminal.NativeHost/WinShell.Terminal.NativeHost.csproj" ReferenceOutputAssembly="false" AdditionalProperties="Platform=AnyCPU" />
    <ProjectReference Include="../WinShell.Mcp/WinShell.Mcp.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" AdditionalProperties="Platform=AnyCPU" />
    <ProjectReference Include="../WinShell.Mcp.Http/WinShell.Mcp.Http.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;RuntimeFrameworkVersion;PublishDir;PublishUrl" AdditionalProperties="Platform=AnyCPU" />
  </ItemGroup>
  <Target Name="IncludeWinUiResourcesInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <WinUiResourcesToPublish Include="@(ApplicationDefinition);@(Page)">
        <ResourceRelativePath>%(RelativeDir)%(Filename).xbf</ResourceRelativePath>
      </WinUiResourcesToPublish>
      <WinUiResourcesToPublish Include="$(AssemblyName).pri" ResourceRelativePath="$(AssemblyName).pri" />
    </ItemGroup>
    <Error Condition="!Exists('$(OutDir)%(WinUiResourcesToPublish.ResourceRelativePath)')" Text="Missing declared WinUI publish resource: %(WinUiResourcesToPublish.ResourceRelativePath). Build the complete App before publishing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)%(WinUiResourcesToPublish.ResourceRelativePath)" RelativePath="%(WinUiResourcesToPublish.ResourceRelativePath)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="CopyMcpHttpCompanion" AfterTargets="Build">
    <PropertyGroup><McpHttpPublishDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/obj/McpHttp/$(Configuration)/'))</McpHttpPublishDirectory></PropertyGroup>
    <MSBuild Projects="../WinShell.Mcp.Http/WinShell.Mcp.Http.csproj" Targets="Publish" Properties="Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(McpHttpPublishDirectory)" RemoveProperties="RuntimeFrameworkVersion;PublishUrl;TargetFramework">
    </MSBuild>
    <ItemGroup><McpHttpRequiredFiles Include="$(McpHttpPublishDirectory)WinShell.Mcp.Http.exe;$(McpHttpPublishDirectory)WinShell.Mcp.Http.runtimeconfig.json;$(McpHttpPublishDirectory)WinShell.Mcp.Http.deps.json;$(McpHttpPublishDirectory)HttpThirdPartyNotices.txt;$(McpHttpPublishDirectory)Licenses/DotNetRuntimeLicense.txt;$(McpHttpPublishDirectory)Licenses/DotNetRuntimeThirdPartyNotices.txt;$(McpHttpPublishDirectory)Licenses/AspNetRuntimeLicense.txt;$(McpHttpPublishDirectory)Licenses/AspNetRuntimeThirdPartyNotices.txt;$(McpHttpPublishDirectory)Licenses/ProtectedDataThirdPartyNotices.txt;$(McpHttpPublishDirectory)Licenses/BouncyCastleLicense.txt;$(McpHttpPublishDirectory)Licenses/McpPlatformNotices.txt;$(McpHttpPublishDirectory)Licenses/WindowsSdkLicense.rtf;$(McpHttpPublishDirectory)Licenses/ConPtyThirdPartyNotices.html" /></ItemGroup>
    <Error Condition="!Exists('%(McpHttpRequiredFiles.Identity)')" Text="Complete self-contained MCP HTTP companion and licenses required: %(McpHttpRequiredFiles.Identity)" />
    <ItemGroup><McpHttpCompanionFiles Include="$(McpHttpPublishDirectory)**/*" /></ItemGroup>
    <Copy SourceFiles="@(McpHttpCompanionFiles)" DestinationFiles="@(McpHttpCompanionFiles->'$(OutDir)McpHttp/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="IncludeMcpHttpCompanionInPublish" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(OutDir)McpHttp/WinShell.Mcp.Http.exe') or !Exists('$(OutDir)McpHttp/HttpThirdPartyNotices.txt') or !Exists('$(OutDir)McpHttp/Licenses/AspNetRuntimeThirdPartyNotices.txt')" Text="Build complete MCP HTTP companion before publishing App." />
    <ItemGroup>
      <McpHttpFilesToPublish Include="$(OutDir)McpHttp/**/*" />
      <ResolvedFileToPublish Include="@(McpHttpFilesToPublish)" RelativePath="McpHttp/%(McpHttpFilesToPublish.RecursiveDir)%(McpHttpFilesToPublish.Filename)%(McpHttpFilesToPublish.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="CopyNativeRenderer" AfterTargets="Build">
    <MSBuild Projects="../WinShell.Terminal.NativeHost/WinShell.Terminal.NativeHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=AnyCPU">
      <Output TaskParameter="TargetOutputs" ItemName="NativeRendererAssembly" />
    </MSBuild>
    <Error Condition="'@(NativeRendererAssembly)' == ''" Text="Native renderer output path must be resolved before packaging the App." />
    <PropertyGroup><NativeRendererOutputDirectory>@(NativeRendererAssembly->'%(RootDir)%(Directory)')</NativeRendererOutputDirectory></PropertyGroup>
    <Error Condition="!Exists('$(NativeRendererOutputDirectory)WinShell.Terminal.NativeHost.exe') or !Exists('$(NativeRendererOutputDirectory)WinShell.Terminal.NativeHost.dll') or !Exists('$(NativeRendererOutputDirectory)WinShell.Terminal.NativeHost.runtimeconfig.json') or !Exists('$(NativeRendererOutputDirectory)WinShell.Terminal.NativeHost.deps.json')" Text="Complete native renderer output must be built before packaging the App." />
    <ItemGroup><NativeRendererFiles Include="$(NativeRendererOutputDirectory)*" /></ItemGroup>
    <Error Condition="'@(NativeRendererFiles)' == ''" Text="Native renderer output must be built before packaging the App." />
    <Copy SourceFiles="@(NativeRendererFiles)" DestinationFolder="$(OutDir)Terminal" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyMcpServer" AfterTargets="Build">
    <MSBuild Projects="../WinShell.Mcp/WinShell.Mcp.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=AnyCPU" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="McpServerAssembly" />
    </MSBuild>
    <Error Condition="'@(McpServerAssembly)' == ''" Text="MCP server output must be built before packaging the App." />
    <PropertyGroup><McpServerOutputDirectory>@(McpServerAssembly->'%(RootDir)%(Directory)')</McpServerOutputDirectory></PropertyGroup>
    <Error Condition="!Exists('$(McpServerOutputDirectory)WinShell.Mcp.dll') or !Exists('$(McpServerOutputDirectory)WinShell.Mcp.runtimeconfig.json') or !Exists('$(McpServerOutputDirectory)WinShell.Mcp.deps.json') or !Exists('$(McpServerOutputDirectory)ThirdPartyNotices.txt') or !Exists('$(McpServerOutputDirectory)SSH-SOURCE-NOTICES.txt') or !Exists('$(McpServerOutputDirectory)SSH.NET.LICENSE')" Text="Complete MCP output and third-party licenses are required before packaging the App." />
    <ItemGroup><McpServerFiles Include="$(McpServerOutputDirectory)**/*" /></ItemGroup>
    <Error Condition="'@(McpServerFiles)' == ''" Text="MCP server deployment file list cannot be empty." />
    <Copy SourceFiles="@(McpServerFiles)" DestinationFiles="@(McpServerFiles->'$(OutDir)Mcp/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="McpPlatformNotices.txt;WindowsSdkLicense.rtf" DestinationFolder="$(OutDir)Mcp" SkipUnchangedFiles="false" />
    <Copy SourceFiles="../WinShell.Terminal.NativeHost/artifacts/stable-native/NOTICE.html" DestinationFiles="$(OutDir)Mcp/ConPtyThirdPartyNotices.html" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyPortablePowerShell" AfterTargets="Build">
    <PropertyGroup><PowerShellRoot>$(MSBuildThisFileDirectory)../../artifacts/powershell/7.6.6/</PowerShellRoot></PropertyGroup>
    <Error Condition="!Exists('$(PowerShellRoot)pwsh.exe') or !Exists('$(PowerShellRoot)LICENSE.txt') or !Exists('$(PowerShellRoot)ThirdPartyNotices.txt')" Text="Run src/WinShell.Infrastructure.Windows/Terminal/Prepare-PowerShell.ps1 before packaging the App." />
    <ItemGroup><PortablePowerShellFiles Include="$(PowerShellRoot)**/*" /></ItemGroup>
    <Copy SourceFiles="@(PortablePowerShellFiles)" DestinationFiles="@(PortablePowerShellFiles->'$(OutDir)PowerShell/7.6.6/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="IncludeMcpServerInPublish" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(OutDir)Mcp/WinShell.Mcp.dll') or !Exists('$(OutDir)Mcp/WinShell.Mcp.runtimeconfig.json') or !Exists('$(OutDir)Mcp/WinShell.Mcp.deps.json') or !Exists('$(OutDir)Mcp/McpPlatformNotices.txt') or !Exists('$(OutDir)Mcp/WindowsSdkLicense.rtf')" Text="Build the complete MCP deployment before publishing the App." />
    <ItemGroup>
      <McpFilesToPublish Include="$(OutDir)Mcp/**/*" />
      <ResolvedFileToPublish Include="@(McpFilesToPublish)" RelativePath="Mcp/%(McpFilesToPublish.RecursiveDir)%(McpFilesToPublish.Filename)%(McpFilesToPublish.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeTerminalRuntimeInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <TerminalRequiredPublishFiles Include="$(OutDir)Terminal/WinShell.Terminal.NativeHost.exe;$(OutDir)Terminal/WinShell.Terminal.NativeHost.dll;$(OutDir)Terminal/WinShell.Terminal.NativeHost.deps.json;$(OutDir)Terminal/WinShell.Terminal.NativeHost.runtimeconfig.json;$(OutDir)Terminal/Microsoft.Terminal.Control.dll;$(OutDir)Terminal/Microsoft.Windows.SDK.NET.dll;$(OutDir)Terminal/WinRT.Runtime.dll;$(OutDir)Terminal/StableNativeEngine.json;$(OutDir)Terminal/ThirdPartyNotices.txt;$(OutDir)Terminal/NOTICE.html" />
    </ItemGroup>
    <Error Condition="!Exists('%(TerminalRequiredPublishFiles.Identity)')" Text="Missing required terminal publish asset: %(TerminalRequiredPublishFiles.Identity). Build the complete App before publishing." />
    <ItemGroup>
      <TerminalFilesToPublish Include="$(OutDir)Terminal/**/*" Exclude="$(OutDir)Terminal/peer.cjs" />
      <ResolvedFileToPublish Include="@(TerminalFilesToPublish)" RelativePath="Terminal/%(TerminalFilesToPublish.RecursiveDir)%(TerminalFilesToPublish.Filename)%(TerminalFilesToPublish.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="IncludePortablePowerShellInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <PowerShellRequiredPublishFiles Include="$(OutDir)PowerShell/7.6.6/pwsh.exe;$(OutDir)PowerShell/7.6.6/pwsh.dll;$(OutDir)PowerShell/7.6.6/pwsh.deps.json;$(OutDir)PowerShell/7.6.6/pwsh.runtimeconfig.json;$(OutDir)PowerShell/7.6.6/LICENSE.txt;$(OutDir)PowerShell/7.6.6/ThirdPartyNotices.txt" />
    </ItemGroup>
    <Error Condition="!Exists('%(PowerShellRequiredPublishFiles.Identity)')" Text="Missing required PowerShell publish asset: %(PowerShellRequiredPublishFiles.Identity). Build the complete App before publishing." />
    <ItemGroup>
      <PowerShellFilesToPublish Include="$(OutDir)PowerShell/7.6.6/**/*" />
      <ResolvedFileToPublish Include="@(PowerShellFilesToPublish)" RelativePath="PowerShell/7.6.6/%(PowerShellFilesToPublish.RecursiveDir)%(PowerShellFilesToPublish.Filename)%(PowerShellFilesToPublish.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
