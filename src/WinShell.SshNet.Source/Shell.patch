+                // it is safe to release the channel's native wait handles and subscriptions.
+                if (_channel != null)
+                {
+                    _channel.DataReceived -= Data;
+                    _channel.ExtendedDataReceived -= ExtendedData;
+                    _channel.RequestReceived -= Request;
+                    _channel.Closed -= Closed;
+                    _channel.Exception -= ChannelError;
+                    ((Channel)_channel).EndOfData -= Eof;
+                    try { _channel.Dispose(); } catch (Exception error) { errors.Add(error); }
+                }
+                _owner._session.Disconnected -= Disconnected;
+                _owner._session.ErrorOccured -= SessionError;
+                _cancellation.Dispose();
+                _stop.Dispose();
+                _owner.IsStarted = false;
+                lock (_gate) { if (_firstFailure != null) errors.Add(_firstFailure); }
+                if (errors.Count != 0) throw new AggregateException("Exclusive shell cleanup failed.", errors);
+            }
