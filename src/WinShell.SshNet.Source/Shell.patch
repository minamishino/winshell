+                {
+                    await _pump.ConfigureAwait(false);
+                    await _inputObservation.ConfigureAwait(false);
+                    _inputCompleted.TrySetResult(true);
+                }
+                catch (Exception error) { _inputCompleted.TrySetException(error); errors.Add(error); }
+                await _inputObservation.ConfigureAwait(false);
+                try { await _resize.ConfigureAwait(false); }
+                catch (SshConnectionException) when (IsClosing()) { }
+                catch (Exception error) { errors.Add(error); }
