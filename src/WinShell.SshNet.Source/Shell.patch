+        /// <summary>
+        /// Starts a single-use shell that exclusively owns this SSH session's shutdown.
+        /// No other channel may share the session. Cancellation, remote close, or failure closes
+        /// the whole session. The client owner must still dispose its SshClient separately.
+        /// </summary>
+        /// <param name="wakeOutput">Idempotent, nonblocking action that wakes every output sink
+        /// before disconnect joins the listener. It must not await shell completion.</param>
+        /// <param name="cancellationToken">Cancellation for this exclusive shell's lifetime.</param>
+        /// <returns>The owned startup task. A failed startup still requires awaiting close.</returns>
+        public System.Threading.Tasks.Task StartExclusiveSessionAsync(Action wakeOutput, CancellationToken cancellationToken = default)
+        {
+            if (wakeOutput == null) throw new ArgumentNullException(nameof(wakeOutput));
+            lock (_exclusiveGate)
+            {
+                if (_disposed || _legacyUsed || IsStarted || _channel != null || _exclusive != null)
+                    throw new InvalidOperationException("Shell has already been used or disposed.");
+                _exclusive = new ExclusiveSession(this, wakeOutput);
+                return _exclusive.Start(cancellationToken);
+            }
+        }
+
+        /// <summary>Gets the actual exclusive input pump completion, including EOF or failure.</summary>
