+        {
+            private readonly Shell _owner;
+            private readonly Action _wakeOutput;
+            private readonly object _gate = new object();
+            private readonly CancellationTokenSource _stop = new CancellationTokenSource();
+            private readonly System.Threading.Tasks.TaskCompletionSource<bool> _inputCompleted =
+                new System.Threading.Tasks.TaskCompletionSource<bool>(System.Threading.Tasks.TaskCreationOptions.RunContinuationsAsynchronously);
+            private CancellationTokenRegistration _cancellation;
+            private CancellationToken _lifetimeToken;
+            private Exception _firstFailure;
+            private IChannelSession _channel;
+            private System.Threading.Tasks.Task _start;
+            private System.Threading.Tasks.Task _pump = System.Threading.Tasks.Task.CompletedTask;
+            private System.Threading.Tasks.Task _inputObservation = System.Threading.Tasks.Task.CompletedTask;
+            private System.Threading.Tasks.Task _resize = System.Threading.Tasks.Task.CompletedTask;
+            private System.Threading.Tasks.Task _close;
+            private bool _closing;
+            private bool _ready;
+            private int? _exitStatus;
+            private string _exitSignal;
+            private bool _remoteEof;
+            private bool _remoteClosed;
+
+            internal ExclusiveSession(Shell owner, Action wakeOutput) { _owner = owner; _wakeOutput = wakeOutput; }
