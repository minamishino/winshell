+        /// <summary>Gets the actual nullable remote exit status; absent is distinct from zero.</summary>
+        public int? ExitStatus => RequireExclusive().ExitStatus;
+        /// <summary>Gets the actual remote exit signal, or null when no signal was received.</summary>
+        public string ExitSignal => RequireExclusive().ExitSignal;
+        /// <summary>Gets whether the peer sent channel EOF, independently of channel close.</summary>
+        public bool RemoteEofReceived => RequireExclusive().RemoteEofReceived;
+        /// <summary>Gets whether the peer sent channel close, not merely local shutdown.</summary>
+        public bool RemoteClosed => RequireExclusive().RemoteClosed;
+
+        /// <summary>Sends an existing SSH window-change request on the exclusive PTY.</summary>
+        /// <remarks>Only one resize may be in flight. Shutdown joins the admitted operation.</remarks>
+        public System.Threading.Tasks.Task ChangeWindowSizeAsync(uint columns, uint rows, uint width, uint height)
+            => RequireExclusive().Resize(columns, rows, width, height);
+
+        /// <summary>
+        /// Wakes sinks and input, disconnects this explicitly exclusive session off the caller
+        /// thread, and joins startup, input, resize and listener before disposing the channel.
+        /// Repeated calls return the same owned task. This operation cannot be abandoned by cancellation.
+        /// </summary>
+        public System.Threading.Tasks.Task CloseExclusiveSessionAsync() => RequireExclusive().Close();
+
+        private ExclusiveSession RequireExclusive()
+        {
+            lock (_exclusiveGate)
+                return _exclusive ?? throw new InvalidOperationException("Call StartExclusiveSessionAsync first.");
+        }
