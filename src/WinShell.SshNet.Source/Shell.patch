+        // Shell-only adapter over the existing mature channel requests/parser. Legacy Start/Stop
+        // remain separate: they must never silently acquire whole-session ownership.
+        [System.Diagnostics.CodeAnalysis.SuppressMessage("Design", "CA1001", Justification = "Owned asynchronous Close task disposes CTS only after all workers join.")]
