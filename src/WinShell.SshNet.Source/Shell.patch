+            private void Closed(object sender, ChannelEventArgs e) { lock (_gate) _remoteClosed = true; _ = Close(); }
+            private void Disconnected(object sender, EventArgs e) { _ = Close(); }
+            private void ChannelError(object sender, ExceptionEventArgs e)
