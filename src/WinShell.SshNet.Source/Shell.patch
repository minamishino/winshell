+                {
+                    _lifetimeToken = cancellationToken;
+                    _start = System.Threading.Tasks.Task.Run(StartCore, CancellationToken.None);
+                    _cancellation = cancellationToken.Register(() => { _ = Close(); });
+                    return _start;
+                }
+            }
