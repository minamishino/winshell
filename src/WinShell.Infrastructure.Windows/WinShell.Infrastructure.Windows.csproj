<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.19045.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- This AnyCPU library must deploy the hosts needed by the x64 App, including ARM64 emulation. -->
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host>true</ConptyRequiresARM64Host>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" />
    <Compile Include="../WinShell.Terminal.Shared/*.cs" Link="Terminal/Shared/%(Filename)%(Extension)" />
    <ProjectReference Include="../WinShell.Core/WinShell.Core.csproj" />
  </ItemGroup>
</Project>
